{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makerflow.local/schemas/constraint_recommendation.schema.json",
  "title": "MakerFlow Constraint Recommendations",
  "description": "W2 product contract for optional recommendations generated from a user-confirmed Creative Brief.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "brief_reference",
    "recommendations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "enum": ["mock", "human", "model"]
    },
    "brief_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief_id", "version", "confirmation_status"],
      "properties": {
        "brief_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "confirmation_status": {
          "const": "confirmed"
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    }
  },
  "$defs": {
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "category",
        "recommendation",
        "based_on",
        "benefit",
        "tradeoff",
        "confidence",
        "requires_user_confirmation"
      ],
      "properties": {
        "recommendation_id": {
          "type": "string",
          "pattern": "^MF-REC-[0-9]{3}$"
        },
        "category": {
          "enum": [
            "form",
            "dimensions",
            "material",
            "color",
            "layout_readability",
            "production_path",
            "output_format"
          ]
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "based_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "benefit": {
          "type": "string",
          "minLength": 1
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "requires_user_confirmation": {
          "type": "boolean"
        }
      }
    }
  }
}

