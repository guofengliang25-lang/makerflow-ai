{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["plan_id", "source_brief_revision", "recommendations", "unresolved_items", "provider_metadata"],
  "additionalProperties": false,
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "source_brief_revision": { "type": "integer", "minimum": 1 },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation_id", "decision_type", "suggestion", "basis", "expected_benefit", "tradeoff", "confidence"],
        "additionalProperties": false,
        "properties": {
          "recommendation_id": { "type": "string", "minLength": 1 },
          "decision_type": { "enum": ["form", "information_hierarchy", "visual_aid", "color_direction", "material_direction"] },
          "suggestion": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 },
          "expected_benefit": { "type": "string", "minLength": 1 },
          "tradeoff": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0 }
        }
      }
    },
    "unresolved_items": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "provider_metadata": {
      "type": "object",
      "required": ["provider_name", "model_name", "prompt_version", "run_id"],
      "additionalProperties": false,
      "properties": {
        "provider_name": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
